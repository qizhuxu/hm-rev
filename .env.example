# hm-api 环境变量示例
#
# 使用方式：
# 1. 复制本文件为 `.env`。
# 2. 启动服务前替换占位值。
# 3. 不要提交 `.env`、真实 API Key、DevEco 凭据、OAuth 回调地址或 token 文件。
#
# 执行 `docker compose up -d` 时，Docker Compose 会自动读取 `.env`。
# 本地 CLI 运行时也可以从当前 shell 环境读取这些变量。

# 服务监听地址。
# - Docker 镜像默认使用 0.0.0.0，便于宿主机访问容器服务。
# - 本地 CLI 默认使用 127.0.0.1，更适合单机私有使用。
# - docker-compose.yml 当前会把容器内监听地址固定为 0.0.0.0。
HM_API_HOST=0.0.0.0

# docker-compose.yml 暴露到宿主机的端口。
# - 容器内部固定监听 8000。
# - 如果本机 8000 已被占用，可以改成其他端口。
# - 示例：HM_API_PORT=18000 时访问 http://127.0.0.1:18000/ui
HM_API_PORT=8000

# 可选 Bearer API Key，用于保护 OpenAI 兼容接口和 /ui/api/* 管理接口。
# - 除纯本机临时测试外，建议始终设置。
# - 请使用足够长、随机、只保存在本地的值。
# - /ui 静态页面仍可直接加载，但管理 API 请求需要携带这个 Key。
# - 请求头示例：Authorization: Bearer <HM_API_KEY>
HM_API_KEY=replace-with-a-local-api-key

# 可选上游 HTTP/HTTPS 代理，用于 hm-api 访问 DevEco 端点。
# - 不需要代理时保持为空。
# - 示例：http://127.0.0.1:7890 或 http://user:pass@proxy.example:8080
# - 如果代理地址里包含用户名和密码，不要提交到 Git。
# - 容器内若要走宿主代理，地址必须容器可达：Docker Desktop 用
#   http://host.docker.internal:7890，Linux 用宿主 LAN IP。
HM_API_PROXY=

# 多账号调度策略。
# - active_only：只使用当前启用账号，兼容旧行为。
# - round_robin：在可用账号之间按请求轮询。
# - failover：优先当前账号，失败时尝试备用账号。
# - UI 中也可以在“模型与能力”页调整策略；示例默认保持兼容旧行为。
HM_API_ACCOUNT_STRATEGY=active_only

# 凭据和运行数据目录（容器内路径）。
# - Docker 默认值是 /data/cred，通常由 hm_api_cred 命名卷或 bind mount 持久化。
# - 本地 CLI 默认值是 ./cred。
# - 这里会保存加密后的账号数据、本地加密密钥材料、登录元数据和 usage.jsonl。
# - 这个目录必须持久化，但绝不能提交到 Git，也不能打包进镜像层。
HM_API_CRED_DIR=/data/cred

# 容器运行用户 uid/gid（仅 Docker 生效）。
# - hm-api 容器以 root 启动 entrypoint，把凭据目录 chown 成这个 uid/gid，
#   再用 gosu 降权运行，所以应用写的 0600 凭据文件能被容器读取。
# - 默认 1000:1000，匹配大多数 NAS/Linux 单用户主机的属主。
# - 用 bind mount 把凭据目录映射到宿主时，把 PUID/PGID 设成你宿主用户的
#   uid/gid（在宿主跑 `id` 查看），这样宿主和容器都能读写同一份凭据。
PUID=1000
PGID=1000

# 凭据目录的宿主侧路径（可选，仅 Docker 生效）。
# - 不设（留空）：使用 docker 命名卷 hm_api_cred，凭据存在 Docker 卷区，
#   不在项目目录里。
# - 设成宿主路径（如 ./cred 或绝对路径）：改为 bind mount，凭据直接落在该
#   目录，便于备份/查看。配合 PUID/PGID 匹配宿主用户，容器可读写 0600 文件。
# - 示例：HM_API_CRED_DIR_HOST=./cred
HM_API_CRED_DIR_HOST=
